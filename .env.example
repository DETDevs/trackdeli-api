# ==============================================================================
# TrackDeli API — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env y completa los valores correspondientes.
# NUNCA agregues valores reales de producción en este archivo ni en git.
# ==============================================================================

# Entorno y Servidor
PORT=
NODE_ENV=

# Base de datos (PostgreSQL)
# Formato: postgresql://<user>:<password>@<host>:<port>/<database>?connection_limit=25&pool_timeout=10
DATABASE_URL=

# Redis (Tracking y WebSockets)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_TLS=

# Autenticación JWT (Generar cadenas aleatorias de 64+ caracteres para producción)
JWT_SECRET=
JWT_EXPIRATION=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=

# Seguridad y CORS
# Lista de orígenes permitidos separados por comas (sin barra final)
CORS_ORIGINS=

# URLs de Aplicaciones Frontend (Requeridas)
TRACKING_URL=
BOOKING_APP_URL=

# Servicio de Correo (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Servicio de WhatsApp Business (Meta Cloud API Directo)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# Almacenamiento de Archivos (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Notificaciones Push (Firebase Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Mapas y Geocodificación (Mapbox)
MAPBOX_ACCESS_TOKEN=

# Monitoreo de Errores (Sentry)
SENTRY_DSN=

# Seed de Base de Datos (Opcional - para desarrollo/testing)
SEED_SUPERADMIN_PASSWORD=