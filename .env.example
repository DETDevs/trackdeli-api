# ==============================================================================
# TrackDeli API — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env y completa los valores correspondientes.
# NUNCA agregues valores reales de producción en este archivo ni en git.
# ==============================================================================

# Entorno y Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
# Formato: postgresql://<user>:<password>@<host>:<port>/<database>?connection_limit=25&pool_timeout=10
DATABASE_URL="postgresql://trackdeli:trackdeli_dev@localhost:5432/trackdeli_dev?connection_limit=25&pool_timeout=10"

# Redis (Tracking y WebSockets)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Autenticación JWT (Generar cadenas aleatorias de 64+ caracteres para producción)
JWT_SECRET=tu-secreto-jwt-aleatorio-de-al-menos-64-caracteres
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=tu-secreto-jwt-refresh-aleatorio-de-al-menos-64-caracteres
JWT_REFRESH_EXPIRATION=7d

# Seguridad y CORS
# Lista de orígenes permitidos separados por comas (sin barra final)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5177

# URLs de Aplicaciones Frontend (Requeridas)
TRACKING_URL=http://localhost:5174
BOOKING_APP_URL=http://localhost:5173

# Servicio de Correo (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="TrackDeli Citas <notificaciones@tu-dominio.com>"

# Almacenamiento de Archivos (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=trackdeli-uploads
R2_PUBLIC_URL=

# Notificaciones Push (Firebase Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Mapas y Geocodificación (Mapbox)
MAPBOX_ACCESS_TOKEN=

# Monitoreo de Errores (Sentry)
SENTRY_DSN=

# Seed de Base de Datos (Opcional - para desarrollo/testing)
SEED_SUPERADMIN_PASSWORD=SuperAdmin2026!