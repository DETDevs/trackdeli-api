generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ENCARGADO
  REPARTIDOR
  SUPERADMIN
}

enum OrderStatus {
  PENDIENTE
  ACEPTADO
  EN_CAMINO_AL_NEGOCIO
  EN_EL_NEGOCIO
  EN_CAMINO
  CERCA_DEL_DESTINO
  VERIFICANDO_ENTREGA
  ENTREGADO
  CANCELADO
  INCIDENCIA
  CERRADO
}

enum DeliveryPaymentStatus {
  PAGADO
  CONTRA_ENTREGA
  GRATIS
}

enum OrderPhotoType {
  ARMADO
  ENTREGA
}

enum VehicleType {
  MOTO
  BICICLETA
  CARRO
  A_PIE
}

enum PricingModel {
  FIXED
  PER_KM
  FREE
}

enum PaymentMethod {
  TRANSFERENCIA
  EFECTIVO
  PAYPAL
  BINANCE
  OTRO
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

model Business {
  id                     String       @id @default(uuid())
  name                   String       @db.VarChar(100)
  type                   String?      @db.VarChar(50)
  logoUrl                String?      @db.VarChar(500)
  defaultGeofenceRadiusM Int          @default(100)
  latitude               Float?
  longitude              Float?
  isActive               Boolean      @default(true)

  // Modelo de precios
  pricingModel           PricingModel @default(FIXED)
  baseRate               Float        @default(0)
  ratePerKm              Float        @default(0)
  freeZoneKm             Float        @default(0)
  minRate                Float        @default(0)
  maxRate                Float        @default(0)

  createdAt              DateTime     @default(now())

  users       User[]
  orders      Order[]
  memberships Membership[]

  @@map("businesses")
}

model Membership {
  id              String           @id @default(uuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id])

  // Período de vigencia
  startDate       DateTime
  endDate         DateTime

  // Pago
  amount          Float
  currency        String           @default("USD")
  paymentMethod   PaymentMethod    @default(TRANSFERENCIA)
  paymentProofUrl String?          @db.VarChar(500)
  paidAt          DateTime?
  notes           String?

  status          MembershipStatus @default(ACTIVE)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String

  @@map("memberships")
}

model User {
  id           String   @id @default(uuid())
  businessId   String?
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  phone        String?  @db.VarChar(20)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(REPARTIDOR)
  isActive     Boolean  @default(true)
  
  vehicleType      VehicleType?
  vehiclePlate     String?
  vehicleColor     String?
  vehiclePhotoUrl  String?
  profilePhotoUrl  String?
  
  currentLatitude  Float?
  currentLongitude Float?
  lastLocationAt   DateTime?
  isAvailable      Boolean  @default(true)
  
  createdAt    DateTime @default(now())

  business              Business?      @relation(fields: [businessId], references: [id])
  createdOrders         Order[]        @relation("OrderCreatedBy")
  deliveredOrders       Order[]        @relation("OrderDeliveredBy")
  locationSnapshots     LocationSnapshot[]
  notifications         Notification[]
  deviceTokens          DeviceToken[]

  @@map("users")
}

model Order {
  id                    String                @id @default(uuid())
  businessId            String
  createdBy             String
  deliveryUserId        String?
  status                OrderStatus           @default(PENDIENTE)

  customerName          String                @db.VarChar(100)
  customerPhone         String                @db.VarChar(20)

  destinationAddress    String?               @db.VarChar(300)
  destinationLat        Decimal?              @db.Decimal(10, 7)
  destinationLng        Decimal?              @db.Decimal(10, 7)
  geofenceRadiusM       Int                   @default(100)

  description           String?

  deliveryPaymentStatus DeliveryPaymentStatus @default(GRATIS)
  deliveryFee           Decimal               @default(0) @db.Decimal(10, 2)
  distanceKm            Float                 @default(0)

  deliveryConfirmationUrl String?             @db.VarChar(500)
  signatureUrl            String?             @db.VarChar(500)

  takenAt               DateTime?
  arrivedAtBusinessAt   DateTime?
  pickedUpAt            DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime              @default(now())

  business              Business              @relation(fields: [businessId], references: [id])
  creator               User                  @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  deliveryUser          User?                 @relation("OrderDeliveredBy", fields: [deliveryUserId], references: [id])
  photos                OrderPhoto[]
  trackingSession       TrackingSession?
  locationSnapshots     LocationSnapshot[]
  rating                Rating?
  notifications         Notification[]

  @@map("orders")
}

model OrderPhoto {
  id        String         @id @default(uuid())
  orderId   String
  photoUrl  String         @db.VarChar(500)
  type      OrderPhotoType
  createdAt DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_photos")
}

model TrackingSession {
  id        String   @id @default(uuid())
  orderId   String   @unique
  token     String   @unique @db.VarChar(64)
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("tracking_sessions")
}

model LocationSnapshot {
  id         String   @id @default(uuid())
  orderId    String
  userId     String
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  speed      Decimal? @db.Decimal(5, 2)
  isMock     Boolean  @default(false)
  recordedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("location_snapshots")
}

model Rating {
  id        String   @id @default(uuid())
  orderId   String   @unique
  stars     Int      @db.SmallInt
  comment   String?
  tipAmount Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("ratings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  orderId   String?
  type      String   @db.VarChar(50)
  title     String?  @db.VarChar(200)
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @db.VarChar(10)  // 'android' | 'ios'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("device_tokens")
}
