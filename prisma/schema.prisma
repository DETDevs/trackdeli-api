generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ENCARGADO
  REPARTIDOR
  SUPERADMIN
  CAJERO
  WAITER
}

enum PosDeviceStatus {
  ACTIVE
  REVOKED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum OrderStatus {
  PENDIENTE
  OFERTADO
  COTIZANDO
  ACEPTADO
  EN_CAMINO_AL_NEGOCIO
  EN_EL_NEGOCIO
  EN_CAMINO
  CERCA_DEL_DESTINO
  VERIFICANDO_ENTREGA
  ENTREGADO
  CANCELADO
  INCIDENCIA
  CERRADO
}

enum BusinessType {
  NEGOCIO
  EMPRESA_RIDERS
}

enum DispatchStatus {
  SENT
  ACCEPTED
  REJECTED
  TIMEOUT
}

enum CommissionStatus {
  PENDING
  INCLUDED
  PAID
}

enum StatementStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum QuoteStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum DeliveryPaymentStatus {
  PAGADO
  CONTRA_ENTREGA
  GRATIS
}

enum OrderPhotoType {
  ARMADO
  ENTREGA
}

enum VehicleType {
  MOTO
  BICICLETA
  CARRO
  A_PIE
}

enum PricingModel {
  FREE
  FIXED
  PER_KM
  RIDER_QUOTE
}

enum PaymentMethod {
  TRANSFERENCIA
  EFECTIVO
  PAYPAL
  BINANCE
  OTRO
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

// ─── POS ENUMS ───

enum PosPaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CREDITO
  MIXTO
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
  VOIDED
  PARTIALLY_RETURNED
  RETURNED
}

enum CashStatus {
  OPEN
  CLOSED
}

enum CreditAccountStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum MovementType {
  ENTRADA
  SALIDA
  DRAWER_OPEN
}

enum StockMovementType {
  COMPRA
  VENTA
  AJUSTE
  DEVOLUCION
  PERDIDA
  TRASLADO
  INITIAL
  PURCHASE
}

enum PurchaseStatus {
  RECEIVED
  VOIDED
}

enum InventoryAdjustmentType {
  COUNT
  SHRINKAGE
  DAMAGE
  EXPIRED
  THEFT
  CORRECTION
  INITIAL
}

enum PosVertical {
  RETAIL
  RESTAURANTE
}

enum ProductFieldDataType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
  DATE
}

enum TableShape {
  ROUND
  SQUARE
}

enum TableOrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum BusinessProductType {
  DELIVERY
  POS
  CARTERA_COBRO
  CITAS
}

enum BusinessProductStatus {
  ACTIVE
  INACTIVE
}

enum BusinessProductAction {
  ACTIVATED
  DEACTIVATED
  DEACTIVATION_BLOCKED
  DEACTIVATION_FORCED
  CONFIG_UPDATED
  RENEWAL_CANCELED
}

model Business {
  id                     String       @id @default(uuid())
  name                   String       @db.VarChar(100)
  slug                   String?      @unique @db.VarChar(100)
  type                   String?      @db.VarChar(50)
  logoUrl                String?      @db.VarChar(500)
  defaultGeofenceRadiusM Int          @default(100)
  latitude               Float?
  longitude              Float?
  isActive               Boolean      @default(true)

  // Tipo de negocio y comisiones [DEPRECATED: Usar BusinessProductSubscription con productType=DELIVERY]
  businessType            BusinessType  @default(NEGOCIO)
  commissionRate          Float         @default(0.15) // 15% default [DEPRECATED]
  altCommissionRate       Float         @default(0.12) // 12% para >40km [DEPRECATED]
  altCommissionDistanceKm Float         @default(40)   // umbral en km [DEPRECATED]
  dispatchTimeoutMin      Int           @default(3)    // minutos antes de pasar al siguiente [DEPRECATED]

  // Módulos activos [DEPRECATED: Usar BusinessProductSubscription con productType=POS / DELIVERY / CARTERA_COBRO]
  hasTrackDeli           Boolean      @default(true)
  hasPOS                 Boolean      @default(false)
  hasCarteraCobro        Boolean      @default(false)
  hasCitas               Boolean      @default(false)

  // Modelo de precios (TrackDeli)
  pricingModel           PricingModel @default(FIXED)
  baseRate               Float        @default(0)
  ratePerKm              Float        @default(0)
  freeZoneKm             Float        @default(0)
  minRate                Float        @default(0)
  maxRate                Float        @default(0)
  pricingZones           Json?

  // Contacto del negocio
  whatsappNumber         String?      @db.VarChar(20)
  whatsappDisplay        String?      @db.VarChar(30)

  // Configuración del POS
  taxConfiguredAt        DateTime?
  taxEnabled             Boolean      @default(false)
  taxIncluded            Boolean      @default(false)
  taxRate                Float        @default(0)
  currency               String       @default("NIO") @db.VarChar(10)
  invoicePrefix          String       @default("FAC") @db.VarChar(10)
  invoiceCounter         Int          @default(1)
  posAddress             String?      @db.VarChar(300)
  posPhone               String?      @db.VarChar(30)
  posFooter              String?      @db.VarChar(200)

  // Vertical de negocio (POS) y dimensiones del layout de mesas
  posVertical            PosVertical  @default(RETAIL)
  salonProfile           String?      @default("RESTAURANTE") @db.VarChar(50)
  posPolicies            PosPolicies?
  gridColumns            Int          @default(10)
  gridRows               Int          @default(10)

  // Umbral de confirmación de ubicación de clientes (días)
  customerLocationMaxDays Int          @default(30)

  // Industria / Tipo de negocio (103a)
  industryId              String?
  industry                Industry?     @relation(fields: [industryId], references: [id])
  usesVariants            Boolean       @default(false)
  tracksBatches           Boolean       @default(false)
  extraUserSlots          Int           @default(0)

  createdAt              DateTime     @default(now())

  // TrackDeli relations
  users       User[]
  orders      Order[]
  memberships Membership[]
  clients     BusinessClient[]
  customers   Customer[]
  commissions OrderCommission[]
  statements  MonthlyStatement[]
  inviteCodes InviteCode[]

  // POS relations
  categories       Category[]
  suppliers        Supplier[]
  products         Product[]
  sales            Sale[]
  cashRegisters    CashRegister[]
  cashMovements    CashMovement[]
  salonZones       SalonZone[]
  restaurantTables RestaurantTable[]
  tableOrders      TableOrder[]
  waiters          Waiter[]
  terminals        PosTerminal[]
  inventoryDiscrepancies InventoryDiscrepancy[]
  creditAccounts   CreditAccount[]
  productFieldDefinitions ProductFieldDefinition[]
  posExchangeRates PosExchangeRate[]
  saleReturns      SaleReturn[]
  posDevices       PosDevice[]

  // Subscripciones de Productos y Auditoría
  productSubscriptions BusinessProductSubscription[]
  productAuditLogs     BusinessProductAuditLog[]

  // Citas / Booking
  services              Service[]
  availabilitySchedules AvailabilitySchedule[]
  bookingSettings       BusinessBookingSettings?
  appointments          Appointment[]
  notificationLogs      NotificationLog[]
  appointmentHolds      AppointmentHold[]
  specialists           Specialist[]
  professions           Profession[]
  purchases             Purchase[]
  inventoryAdjustments  InventoryAdjustment[]
  creditGroups          CreditGroup[]
  creditStatements      CreditStatement[]
  productComponents     ProductComponent[]

  @@map("businesses")
}

model BusinessClient {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String   @db.VarChar(150)
  phone      String?  @db.VarChar(30)
  address    String?  @db.VarChar(300)
  latitude   Float?
  longitude  Float?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  orders     Order[]

  @@map("business_clients")
}

model Membership {
  id              String           @id @default(uuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id])

  // Período de vigencia
  startDate       DateTime
  endDate         DateTime

  // Pago
  amount         Decimal @db.Decimal(12,2)
  currency        String           @default("USD")
  paymentMethod   PaymentMethod    @default(TRANSFERENCIA)
  paymentProofUrl String?          @db.VarChar(500)
  paidAt          DateTime?
  notes           String?

  status          MembershipStatus @default(ACTIVE)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String

  paymentProducts MembershipPaymentProduct[]

  @@map("memberships")
}

model User {
  id              String       @id @default(uuid())
  businessId      String?
  name            String       @db.VarChar(100)
  email           String       @unique @db.VarChar(150)
  phone           String?      @db.VarChar(20)
  passwordHash    String?      @db.VarChar(255)
  authProvider    AuthProvider @default(EMAIL)
  profileComplete Boolean      @default(false)
  role            UserRole     @default(REPARTIDOR)
  isActive        Boolean      @default(true)
  
  vehicleType      VehicleType?
  vehiclePlate     String?
  vehicleColor     String?
  vehiclePhotoUrl  String?
  profilePhotoUrl  String?
  
  currentLatitude  Float?
  currentLongitude Float?
  lastLocationAt   DateTime?
  isAvailable      Boolean  @default(true)
  
  createdAt    DateTime @default(now())

  // TrackDeli relations
  business              Business?          @relation(fields: [businessId], references: [id])
  createdOrders         Order[]            @relation("OrderCreatedBy")
  deliveredOrders       Order[]            @relation("OrderDeliveredBy")
  locationSnapshots     LocationSnapshot[]
  notifications         Notification[]
  deviceTokens          DeviceToken[]
  quotes                OrderQuote[]       @relation("RiderQuotes")
  sentMessages          OrderMessage[]     @relation("SentMessages")
  dispatches            OrderDispatch[]    @relation("RiderDispatches")
  inviteCodeUsage       InviteCodeUsage?

  // POS relations
  sales          Sale[]          @relation("CashierSales")
  cashRegisters  CashRegister[]  @relation("CashierRegisters")
  cashMovements  CashMovement[]  @relation("UserMovements")
  stockMovements StockMovement[] @relation("UserStockMovements")
  receivedCreditPayments CreditPayment[] @relation("CreditPaymentsReceived")
  posPayments    PosPayment[]    @relation("UserPayments")
  setExchangeRates PosExchangeRate[] @relation("UserSetExchangeRates")

  purchases             Purchase[]          @relation("UserPurchases")
  voidedPurchases       Purchase[]          @relation("UserVoidedPurchases")
  inventoryAdjustments  InventoryAdjustment[] @relation("UserAdjustments")
  approvedInventoryAdjustments InventoryAdjustment[] @relation("UserApprovedAdjustments")

  // Password audit relations
  passwordChangesReceived PasswordChangeLog[] @relation("PasswordChangesReceived")
  passwordChangesGiven    PasswordChangeLog[] @relation("PasswordChangesGiven")

  @@map("users")
}

model Order {
  id                    String                @id @default(uuid())
  businessId            String
  createdBy             String
  deliveryUserId        String?
  status                OrderStatus           @default(PENDIENTE)

  customerName          String                @db.VarChar(100)
  customerPhone         String                @db.VarChar(20)

  originBusinessName     String?               @db.VarChar(150)
  originBusinessClientId String?
  originBusinessClient   BusinessClient?       @relation(fields: [originBusinessClientId], references: [id])

  destinationAddress    String?               @db.VarChar(300)
  destinationLat        Decimal?              @db.Decimal(10, 7)
  destinationLng        Decimal?              @db.Decimal(10, 7)
  geofenceRadiusM       Int                   @default(100)

  description           String?

  deliveryPaymentStatus DeliveryPaymentStatus @default(GRATIS)
  deliveryFee           Decimal               @default(0) @db.Decimal(10, 2)
  distanceKm            Float                 @default(0)
  priceNegotiated       Boolean               @default(false)

  deliveryConfirmationUrl String?             @db.VarChar(500)
  signatureUrl            String?             @db.VarChar(500)

  takenAt               DateTime?
  arrivedAtBusinessAt   DateTime?
  pickedUpAt            DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime              @default(now())

  business              Business              @relation(fields: [businessId], references: [id])
  creator               User                  @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  deliveryUser          User?                 @relation("OrderDeliveredBy", fields: [deliveryUserId], references: [id])
  photos                OrderPhoto[]
  trackingSession       TrackingSession?
  locationSnapshots     LocationSnapshot[]
  rating                Rating?
  notifications         Notification[]
  quotes                OrderQuote[]
  messages              OrderMessage[]
  dispatches            OrderDispatch[]
  commission            OrderCommission?

  @@map("orders")
}

model OrderDispatch {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id])
  riderId     String
  rider       User           @relation("RiderDispatches", fields: [riderId], references: [id])
  attempt     Int            // intento #1, #2, #3...
  status      DispatchStatus @default(SENT)
  sentAt      DateTime       @default(now())
  respondedAt DateTime?
  timeoutAt   DateTime       // cuando expira si no responde

  @@index([orderId, attempt])
  @@map("order_dispatches")
}

model OrderCommission {
  id               String            @id @default(uuid())
  orderId          String            @unique
  order            Order             @relation(fields: [orderId], references: [id])
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id])
  deliveryFee      Float             // monto del envío cobrado al cliente
  distanceKm       Float             // distancia recorrida
  commissionRate   Float             // 0.15 o 0.12
  commissionAmount Float             // monto de comisión = deliveryFee * commissionRate
  status           CommissionStatus  @default(PENDING)
  statementId      String?           // a qué estado de cuenta pertenece
  statement        MonthlyStatement? @relation(fields: [statementId], references: [id])
  createdAt        DateTime          @default(now())

  @@map("order_commissions")
}

model MonthlyStatement {
  id               String            @id @default(uuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id])
  month            Int               // 1-12
  year             Int
  totalDeliveries  Int               // cantidad de pedidos entregados
  totalDeliveryFee Float             // suma de todos los montos de envío
  totalCommission  Float             // suma de todas las comisiones = lo que debe pagar
  status           StatementStatus   @default(PENDING)
  dueDate          DateTime          // fecha límite de pago (ej: 5 del mes siguiente)
  paidAt           DateTime?
  paidAmount       Float?            // puede ser pago parcial
  notes            String?
  commissions      OrderCommission[]
  createdAt        DateTime          @default(now())

  @@unique([businessId, month, year])
  @@map("monthly_statements")
}

model OrderQuote {
  id                   String       @id @default(uuid())
  orderId              String
  order                Order        @relation(fields: [orderId], references: [id])
  riderId              String
  rider                User         @relation("RiderQuotes", fields: [riderId], references: [id])

  proposedFee          Float
  counterFee           Float?
  finalFee             Float?

  distanceToBusinessKm Float?
  etaToBusinessMin     Int?

  status               QuoteStatus  @default(PENDING)

  messages             OrderMessage[]

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([orderId, riderId])
  @@map("order_quotes")
}

model OrderMessage {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  quoteId     String?
  quote       OrderQuote? @relation(fields: [quoteId], references: [id])
  senderId    String
  sender      User        @relation("SentMessages", fields: [senderId], references: [id])
  senderRole  UserRole
  message     String      @db.VarChar(500)
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@map("order_messages")
}

model OrderPhoto {
  id        String         @id @default(uuid())
  orderId   String
  photoUrl  String         @db.VarChar(500)
  type      OrderPhotoType
  createdAt DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_photos")
}

model TrackingSession {
  id        String   @id @default(uuid())
  orderId   String   @unique
  token     String   @unique @db.VarChar(64)
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("tracking_sessions")
}

model PosPolicies {
  businessId                 String   @id
  business                   Business @relation(fields: [businessId], references: [id])

  returnsEnabled             Boolean  @default(true)
  returnsRequireApproval     Boolean  @default(true)
  returnsMaxDays             Int      @default(30)
  
  voidsCompletedEnabled      Boolean  @default(true)
  voidsRequireApproval       Boolean  @default(true)
  
  discountsEnabled           Boolean  @default(true)
  cashierMaxDiscountPercent  Float    @default(10)
  priceOverrideEnabled       Boolean  @default(false)
  
  paymentMethodsEnabled      String   @default("EFECTIVO,TARJETA,TRANSFERENCIA,CREDITO,OTRO") // CSV parsed in code
  requireReferenceCard       Boolean  @default(true)
  requireReferenceTransfer   Boolean  @default(true)
  requireReferenceOther      Boolean  @default(false)
  
  multiCurrencyEnabled       Boolean  @default(false)
  acceptedCurrencies         String   @default("NIO") // NIO,USD

  blindCashClose             Boolean  @default(true)
  cashDifferenceTolerance    Decimal  @default(0) @db.Decimal(12,2)
  noSaleDrawerOpenAllowed    Boolean  @default(true)
  
  allowNegativeStock         Boolean  @default(false)
  inventoryAdjustRequireApproval Boolean @default(true)
  creditLimitOverrideRequiresApproval Boolean @default(true)

  @@map("pos_policies")
}

model PosAuditLog {
  id           String   @id @default(uuid())
  businessId   String
  userId       String
  userRole     String
  action       String   @db.VarChar(100)
  entityType   String?  @db.VarChar(100)
  entityId     String?  @db.VarChar(100)
  before       Json?
  after        Json?
  reason       String?  @db.VarChar(500)
  terminalId   String?  @db.VarChar(100)
  ipAddress    String?  @db.VarChar(100)
  approvedById String?  @db.VarChar(100)
  createdAt    DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([userId])
  @@index([action])
  @@map("pos_audit_logs")
}

model PosApprovalToken {
  id           String   @id @default(uuid())
  businessId   String
  token        String   @unique @db.VarChar(100)
  action       String   @db.VarChar(100)
  entityType   String?  @db.VarChar(100)
  entityId     String?  @db.VarChar(100)
  approvedById String
  terminalId   String?  @db.VarChar(100)
  isUsed       Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([businessId, token])
  @@map("pos_approval_tokens")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  businessId   String
  key          String   @db.VarChar(100)
  requestHash  String   @db.VarChar(100)
  responseBody Json?
  statusCode   Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([businessId, key])
  @@map("idempotency_keys")
}

model Customer {
  id              String                    @id @default(uuid())
  businessId      String
  business        Business                  @relation(fields: [businessId], references: [id])
  phone           String?                   @db.VarChar(30)
  name            String                    @db.VarChar(100)
  email           String?                   @db.VarChar(255)
  notes           String?
  lastLatitude    Float?
  lastLongitude   Float?
  lastAddressText String?                   @db.VarChar(300)
  lastConfirmedAt DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  creditLimit     Float?
  ruc             String?                   @db.VarChar(30)
  isBlocked       Boolean                   @default(false)
  consecutiveNoShows Int                    @default(0)
  groupId         String?
  group           CreditGroup?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  externalCode    String?                   @db.VarChar(50)

  locationSessions CustomerLocationSession[]
  sales            Sale[]
  creditAccounts   CreditAccount[]
  appointments     Appointment[]
  statementItems   CreditStatementItem[]

  @@unique([businessId, phone])
  @@index([businessId, phone])
  @@index([businessId, name])
  @@index([businessId, externalCode])
  @@index([businessId, groupId])
  @@map("customers")
}

model CustomerLocationSession {
  id          String    @id @default(uuid())
  customerId  String
  token       String    @unique @db.VarChar(64)
  shortCode   String?   @unique @db.VarChar(16)
  isActive    Boolean   @default(true)
  status      String    @default("PENDING") @db.VarChar(20)
  respondedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shortCode])
  @@map("customer_location_sessions")
}

model LocationSnapshot {
  id         String   @id @default(uuid())
  orderId    String
  userId     String
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  speed      Decimal? @db.Decimal(5, 2)
  isMock     Boolean  @default(false)
  recordedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("location_snapshots")
}

model Rating {
  id        String   @id @default(uuid())
  orderId   String   @unique
  stars     Int      @db.SmallInt
  comment   String?
  tipAmount Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("ratings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  orderId   String?
  type      String   @db.VarChar(50)
  title     String?  @db.VarChar(200)
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("device_tokens")
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationLogStatus {
  PENDING
  SENT
  FAILED
  SIMULATED
}

model NotificationLog {
  id                String                @id @default(uuid())
  businessId        String?
  channel           NotificationChannel
  event             String                @db.VarChar(100)
  recipientContact  String                @db.VarChar(255)
  status            NotificationLogStatus @default(PENDING)
  sentAt            DateTime?
  errorMessage      String?               @db.Text
  relatedEntityType String?               @db.VarChar(100)
  relatedEntityId   String?               @db.VarChar(100)
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  business          Business?             @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([channel, event])
  @@index([relatedEntityType, relatedEntityId])
  @@index([recipientContact])
  @@index([status])
  @@map("notification_logs")
}

// ═══════════════════════════════════════════════
// POS MODELS
// ═══════════════════════════════════════════════

model Category {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  name       String    @db.VarChar(100)
  color      String?   @db.VarChar(10)
  icon       String?   @db.VarChar(50)
  isActive   Boolean   @default(true)
  products   Product[]
  createdAt  DateTime  @default(now())

  @@unique([businessId, name])
  @@map("pos_categories")
}

model Supplier {
  id         String     @id @default(uuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id])
  name       String     @db.VarChar(100)
  phone      String?    @db.VarChar(30)
  email      String?    @db.VarChar(150)
  address    String?    @db.VarChar(300)
  taxId      String?    @db.VarChar(50)
  notes      String?
  isActive   Boolean    @default(true)
  products   Product[]
  purchases  Purchase[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt

  @@map("pos_suppliers")
}

model Product {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])

  name        String    @db.VarChar(200)
  description String?
  barcode     String?   @db.VarChar(50)
  sku         String?   @db.VarChar(50)
  imageUrl    String?   @db.VarChar(500)

  price       Float
  cost        Float?
  taxIncluded Boolean   @default(true)

  unit        String   @default("UND") @db.VarChar(10)
  isRecipe    Boolean  @default(false)
  trackStock  Boolean  @default(true)
  stock       Decimal  @default(0) @db.Decimal(12, 3)
  minStock    Decimal  @default(5) @db.Decimal(12, 3)
  maxStock    Decimal? @db.Decimal(12, 3)

  isActive    Boolean   @default(true)
  attributes  Json      @default("{}")

  saleItems              SaleItem[]
  saleReturnItems        SaleReturnItem[]
  stockMovements         StockMovement[]
  tableOrderItems        TableOrderItem[]
  inventoryDiscrepancies InventoryDiscrepancy[]
  purchaseItems          PurchaseItem[]
  costHistories          ProductCostHistory[]
  inventoryAdjustments   InventoryAdjustment[]
  recipeComponents       ProductComponent[]    @relation("ParentProductComponents")
  usedInRecipes          ProductComponent[]    @relation("ComponentProductUsages")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, barcode])
  @@unique([businessId, sku])
  @@map("pos_products")
}

model ProductComponent {
  id                 String   @id @default(uuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parentProductId    String
  parentProduct      Product  @relation("ParentProductComponents", fields: [parentProductId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct   Product  @relation("ComponentProductUsages", fields: [componentProductId], references: [id], onDelete: Cascade)
  quantity           Decimal  @db.Decimal(12, 3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([parentProductId, componentProductId])
  @@index([businessId])
  @@index([parentProductId])
  @@index([componentProductId])
  @@map("pos_product_components")
}

model Sale {
  id             String           @id @default(uuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id])
  cashRegisterId String?
  cashRegister   CashRegister?    @relation(fields: [cashRegisterId], references: [id])
  cashierId      String
  cashier        User             @relation("CashierSales", fields: [cashierId], references: [id])

  clientGeneratedId String?
  occurredAt        DateTime?
  syncedAt          DateTime?
  isOffline         Boolean        @default(false)
  soldWithoutOpenShift Boolean     @default(false)
  posTerminalId     String?
  posTerminal       PosTerminal?   @relation(fields: [posTerminalId], references: [id])

  invoiceNumber  String           @db.VarChar(30)
  invoiceDate    DateTime         @default(now())

  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  customerName   String?          @db.VarChar(120)
  customerPhone  String?          @db.VarChar(30)
  customerRuc    String?          @db.VarChar(30)
  tableNumber    String?          @db.VarChar(50)
  zoneName       String?          @db.VarChar(100)
  waiterName     String?          @db.VarChar(100)
  vehicleInfo    String?          @db.VarChar(120)

  creditAccount  CreditAccount?
  items          SaleItem[]
  inventoryDiscrepancies InventoryDiscrepancy[]
  payments       PosPayment[]

  subtotal       Float
  discountAmount Float            @default(0)
  taxRate        Float            @default(0)
  taxEnabled     Boolean          @default(false)
  taxIncluded    Boolean          @default(false)
  taxAmount      Float            @default(0)
  total          Float

  paymentMethod  PosPaymentMethod @default(EFECTIVO)
  amountPaid     Float
  change         Decimal @default(0) @db.Decimal(12,2)
  reference      String?          @db.VarChar(100)

  status         SaleStatus       @default(COMPLETED)
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?          @db.VarChar(500)
  voidApprovedById String?
  hasNegativeStock Boolean        @default(false)
  notes          String?
  printCount     Int              @default(0)

  returns             SaleReturn[]
  creditStatementItem CreditStatementItem?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("pos_sales")
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])

  productName String   @db.VarChar(200)
  barcode     String?  @db.VarChar(50)
  unitPrice   Float
  quantity    Float
  discount    Float    @default(0)
  subtotal    Float
  returnedQty Float    @default(0)

  returnItems SaleReturnItem[]

  @@map("pos_sale_items")
}

model SaleReturn {
  id           String           @id @default(uuid())
  saleId       String
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  returnNumber String           @db.VarChar(30)
  reason       String           @db.VarChar(100)
  notes        String?          @db.VarChar(500)
  refundMethod PosPaymentMethod
  refundAmount Float
  taxRefunded  Float            @default(0)
  createdById  String
  approvedById String?
  shiftId      String?
  createdAt    DateTime         @default(now())

  items        SaleReturnItem[]

  @@index([saleId])
  @@index([businessId, createdAt])
  @@map("pos_sale_returns")
}

model SaleReturnItem {
  id               String      @id @default(uuid())
  returnId         String
  saleReturn       SaleReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId       String
  saleItem         SaleItem    @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?    @relation(fields: [productId], references: [id])
  productName      String      @db.VarChar(200)
  quantity         Float
  unitPrice        Float
  discountProrated Float       @default(0)
  taxRate          Float       @default(0)
  taxIncluded      Boolean     @default(false)
  taxAmount        Float       @default(0)
  refundAmount     Float
  restock          Boolean     @default(true)
  createdAt        DateTime    @default(now())

  @@index([returnId])
  @@index([saleItemId])
  @@map("pos_sale_return_items")
}

model PosPayment {
  id             String           @id @default(uuid())
  saleId         String
  sale           Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method         PosPaymentMethod
  amount         Decimal @db.Decimal(12,2)
  amountTendered Decimal? @db.Decimal(12,2)
  change         Decimal @default(0) @db.Decimal(12,2)
  reference      String?          @db.VarChar(100)
  
  // Future-proofing for 113c
  currency       String           @default("NIO") @db.VarChar(10)
  exchangeRate   Decimal          @default(1) @db.Decimal(10,4)
  amountBase     Decimal          @default(0) @db.Decimal(12,2)
  
  shiftId        String?
  shift          CashRegister?    @relation(fields: [shiftId], references: [id])
  createdById    String
  createdBy      User             @relation("UserPayments", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())

  @@index([saleId])
  @@index([shiftId])
  @@map("pos_payments")
}

model CreditAccount {
  id             String              @id @default(uuid())
  saleId         String              @unique
  sale           Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id])
  businessId     String
  business       Business            @relation(fields: [businessId], references: [id])
  originalAmount Float
  balance        Float
  status         CreditAccountStatus @default(PENDING)
  dueDate        DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  payments       CreditPayment[]

  @@index([businessId, status, dueDate])
  @@index([businessId, customerId])
  @@map("pos_credit_accounts")
}

model CreditPayment {
  id               String           @id @default(uuid())
  creditAccountId  String
  creditAccount    CreditAccount    @relation(fields: [creditAccountId], references: [id], onDelete: Restrict)
  amount         Decimal @db.Decimal(12,2)
  paymentMethod    PosPaymentMethod @default(EFECTIVO)
  receivedByUserId String
  receivedByUser   User             @relation("CreditPaymentsReceived", fields: [receivedByUserId], references: [id])
  receivedAt       DateTime         @default(now())
  notes            String?
  createdAt        DateTime         @default(now())

  @@index([creditAccountId])
  @@map("pos_credit_payments")
}

model CreditGroup {
  id           String            @id @default(uuid())
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String            @db.VarChar(150)
  taxId        String?           @db.VarChar(50)
  contactName  String?           @db.VarChar(150)
  contactPhone String?           @db.VarChar(50)
  contactEmail String?           @db.VarChar(255)
  billingCycle String            @default("BIWEEKLY") @db.VarChar(30)
  cutDay1      Int?
  cutDay2      Int?
  payDayOffset Int?              @default(0)
  creditLimit  Decimal?          @db.Decimal(12, 2)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  customers    Customer[]
  statements   CreditStatement[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@map("pos_credit_groups")
}

model CreditStatement {
  id              String                @id @default(uuid())
  businessId      String
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  groupId         String
  group           CreditGroup           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  statementNumber String?               @db.VarChar(50)
  periodFrom      DateTime
  periodTo        DateTime
  cutDate         DateTime              @default(now())
  payDueDate      DateTime?
  status          String                @default("OPEN") @db.VarChar(30)
  totalAmount     Decimal               @default(0) @db.Decimal(12, 2)
  settledAmount   Decimal               @default(0) @db.Decimal(12, 2)
  notes           String?
  createdById     String
  settledById     String?
  settledAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  items           CreditStatementItem[]

  @@index([businessId, groupId])
  @@index([groupId, status])
  @@map("pos_credit_statements")
}

model CreditStatementItem {
  id            String          @id @default(uuid())
  statementId   String
  statement     CreditStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  saleId        String          @unique
  sale          Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount        Decimal         @default(0) @db.Decimal(12, 2)
  settledAmount Decimal         @default(0) @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())

  @@index([statementId])
  @@index([customerId])
  @@map("pos_credit_statement_items")
}

model CashRegister {
  id            String     @id @default(uuid())
  businessId    String
  business      Business   @relation(fields: [businessId], references: [id])
  cashierId     String
  cashier       User       @relation("CashierRegisters", fields: [cashierId], references: [id])

  openedAt      DateTime   @default(now())
  closedAt      DateTime?

  openingCash   Decimal @db.Decimal(12,2)
  closingCash   Decimal? @db.Decimal(12,2)
  expectedCash  Decimal? @db.Decimal(12,2)
  difference    Decimal? @db.Decimal(12,2)

  expectedCashUsd Decimal? @db.Decimal(12,2)
  closingCashUsd  Decimal? @db.Decimal(12,2)
  differenceUsd   Decimal? @db.Decimal(12,2)
  totalCashUsd    Decimal? @db.Decimal(12,2)

  totalSales    Decimal? @db.Decimal(12,2)
  totalCash     Decimal? @db.Decimal(12,2)
  totalCard     Decimal? @db.Decimal(12,2)
  totalTransfer Decimal? @db.Decimal(12,2)

  notes         String?
  status        CashStatus @default(OPEN)

  sales         Sale[]
  movements     CashMovement[]
  payments      PosPayment[]

  createdAt     DateTime   @default(now())

  @@map("pos_cash_registers")
}

model CashMovement {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  userId         String
  user           User         @relation("UserMovements", fields: [userId], references: [id])

  type           MovementType
  amount         Decimal @db.Decimal(12,2)
  concept        String       @db.VarChar(300)
  currency       String       @default("NIO") @db.VarChar(10)
  exchangeRate   Decimal      @default(1) @db.Decimal(10,4)
  amountBase     Decimal      @default(0) @db.Decimal(12,2)

  createdAt      DateTime     @default(now())

  @@map("pos_cash_movements")
}

model PosExchangeRate {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  base          String   @default("NIO") @db.VarChar(10)
  quote         String   @default("USD") @db.VarChar(10)
  rate          Decimal  @db.Decimal(10, 4)
  source        String   @default("MANUAL") @db.VarChar(20) // OFICIAL | MANUAL
  effectiveFrom DateTime @default(now())
  setById       String?
  setBy         User?    @relation("UserSetExchangeRates", fields: [setById], references: [id])
  createdAt     DateTime @default(now())

  @@index([businessId, quote, effectiveFrom])
  @@map("pos_exchange_rates")
}

model Purchase {
  id            String         @id @default(uuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id])
  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  invoiceNumber String?        @db.VarChar(100)
  purchaseDate  DateTime       @default(now())
  notes         String?
  status        PurchaseStatus @default(RECEIVED)
  total         Decimal        @db.Decimal(12, 2)
  createdById   String
  createdBy     User           @relation("UserPurchases", fields: [createdById], references: [id])
  voidedAt      DateTime?
  voidedById    String?
  voidedBy      User?          @relation("UserVoidedPurchases", fields: [voidedById], references: [id])
  voidReason    String?        @db.VarChar(500)
  items         PurchaseItem[]
  costHistories ProductCostHistory[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([businessId, purchaseDate])
  @@index([businessId, supplierId])
  @@map("pos_purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @db.Decimal(12, 4)
  subtotal   Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([purchaseId])
  @@map("pos_purchase_items")
}

model ProductCostHistory {
  id         String    @id @default(uuid())
  businessId String
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  oldCost    Decimal?  @db.Decimal(12, 4)
  newCost    Decimal   @db.Decimal(12, 4)
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  date       DateTime  @default(now())
  reason     String?   @db.VarChar(200)

  @@index([productId, date])
  @@map("pos_product_cost_history")
}

model InventoryAdjustment {
  id          String                  @id @default(uuid())
  businessId  String
  business    Business                @relation(fields: [businessId], references: [id])
  productId   String
  product     Product                 @relation(fields: [productId], references: [id])
  type        InventoryAdjustmentType
  qtyDelta    Decimal                 @db.Decimal(12, 3)
  reason      String                  @db.VarChar(500)
  notes       String?
  userId      String
  user        User                    @relation("UserAdjustments", fields: [userId], references: [id])
  approvedById String?
  approvedBy  User?                   @relation("UserApprovedAdjustments", fields: [approvedById], references: [id])
  costAtTime  Decimal?                @db.Decimal(12, 4)
  createdAt   DateTime                @default(now())

  @@index([businessId, productId])
  @@index([businessId, createdAt])
  @@map("pos_inventory_adjustments")
}

model StockMovement {
  id          String            @id @default(uuid())
  businessId  String
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  userId      String
  user        User              @relation("UserStockMovements", fields: [userId], references: [id])

  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  stockBefore Decimal           @db.Decimal(12, 3)
  stockAfter  Decimal           @db.Decimal(12, 3)
  cost        Decimal?          @db.Decimal(12, 4)
  concept     String            @db.VarChar(300)
  reference   String?           @db.VarChar(100)

  createdAt   DateTime          @default(now())

  @@map("pos_stock_movements")
}

model InviteCode {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  code        String    @unique // ej: "RAPID2026" o UUID corto
  description String?   @db.VarChar(100) // ej: "Para riders de Masaya"
  maxUses     Int?      // null = usos ilimitados
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  expiresAt   DateTime? // null = no expira
  createdAt   DateTime  @default(now())

  usages      InviteCodeUsage[]

  @@map("invite_codes")
}

model InviteCodeUsage {
  id           String     @id @default(uuid())
  inviteCodeId String
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id])
  riderId      String     @unique // un rider solo puede usar un código
  rider        User       @relation(fields: [riderId], references: [id])
  usedAt       DateTime   @default(now())

  @@map("invite_code_usages")
}

// ═══════════════════════════════════════════════
// POS RESTAURANT TABLES & TABLE ORDERS
// ═══════════════════════════════════════════════

model SalonZone {
  id         String            @id @default(uuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String            @db.VarChar(50)
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tables     RestaurantTable[]

  @@index([businessId, isActive])
  @@map("pos_salon_zones")
}

model RestaurantTable {
  id         String           @id @default(uuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  zoneId     String?
  zone       SalonZone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  number     String           @db.VarChar(50)
  capacity   Int              @default(4)
  shape      TableShape       @default(SQUARE)
  gridX      Int?
  gridY      Int?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  orders     TableOrder[]

  @@unique([businessId, number])
  @@index([businessId])
  @@index([zoneId])
  @@map("pos_restaurant_tables")
}

model TableOrder {
  id         String           @id @default(uuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tableId    String
  table      RestaurantTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status     TableOrderStatus @default(OPEN)
  createdAt  DateTime         @default(now())
  closedAt   DateTime?
  saleId             String?
  notes              String?
  openedByWaiterId   String?          @db.VarChar(100)
  openedByWaiterName String?          @db.VarChar(100)
  customerName       String?          @db.VarChar(120)
  customerPhone      String?          @db.VarChar(30)
  vehicleInfo        String?          @db.VarChar(120)
  assignedWaiterId   String?
  assignedWaiter     Waiter?          @relation("AssignedWaiterOrders", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancelledByUserId  String?          @db.VarChar(100)
  cancelledByUserName String?         @db.VarChar(100)
  cancellationReason String?          @db.VarChar(500)

  items      TableOrderItem[]

  @@index([businessId, status])
  @@index([tableId, status])
  @@index([assignedWaiterId])
  @@map("pos_table_orders")
}

model TableOrderItem {
  id           String      @id @default(uuid())
  tableOrderId String
  tableOrder   TableOrder  @relation(fields: [tableOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product?    @relation(fields: [productId], references: [id])
  productName  String      @db.VarChar(200)
  quantity     Decimal     @db.Decimal(12, 3)
  unitPrice    Float
  notes        String?
  waiterId     String?     @db.VarChar(100)
  waiterName   String?     @db.VarChar(100)
  createdAt    DateTime    @default(now())

  @@map("pos_table_order_items")
}

model Waiter {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String       @db.VarChar(100)
  pinHash        String       @db.VarChar(100)
  active         Boolean      @default(true)
  assignedOrders TableOrder[] @relation("AssignedWaiterOrders")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([businessId])
  @@map("pos_waiters")
}

// ═══════════════════════════════════════════════
// 132a — DISPOSITIVOS POS
// ═══════════════════════════════════════════════

model PosDevice {
  id          String          @id @default(uuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deviceId    String          @db.VarChar(100)
  name        String?         @db.VarChar(100)
  platform    String?         @db.VarChar(50)
  appVersion  String?         @db.VarChar(50)
  status      PosDeviceStatus @default(ACTIVE)
  firstSeenAt DateTime        @default(now())
  lastSeenAt  DateTime        @default(now())
  lastUserId  String?         @db.VarChar(100)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([businessId, deviceId])
  @@index([businessId, status])
  @@map("pos_devices")
}

// ═══════════════════════════════════════════════
// BUSINESS PRODUCT SUBSCRIPTIONS & AUDIT LOGS
// ═══════════════════════════════════════════════

model BusinessProductSubscription {
  id                      String                 @id @default(uuid())
  businessId              String
  business                Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productType             BusinessProductType
  status                  BusinessProductStatus  @default(INACTIVE)

  // Config específica de cada producto — nullable porque no aplica al otro tipo
  // DELIVERY:
  commissionRate          Decimal?               @db.Decimal(10, 4)
  altCommissionRate       Decimal?               @db.Decimal(10, 4)
  altCommissionDistanceKm Decimal?               @db.Decimal(10, 2)
  dispatchTimeoutMin      Int?
  deliveryMonthlyFee      Decimal?               @db.Decimal(10, 2)
  // POS:
  posVertical             PosVertical?
  posMonthlyFee           Decimal?               @db.Decimal(10, 2)
  maxDevices              Int?
  // CARTERA_COBRO:
  carteraMonthlyFee       Decimal?               @db.Decimal(10, 2)
  // CITAS:
  citasMonthlyFee         Decimal?               @db.Decimal(10, 2)

  activatedAt             DateTime?
  activatedBy             String?                // userId del SuperAdmin que activó
  deactivatedAt           DateTime?
  deactivatedBy           String?

  autoRenew               Boolean                @default(true)
  renewalCanceledAt       DateTime?

  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  membershipPayments      MembershipPaymentProduct[]

  @@unique([businessId, productType])
  @@index([businessId])
  @@map("business_product_subscriptions")
}

model BusinessProductAuditLog {
  id           String                  @id @default(uuid())
  businessId   String
  business     Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productType  BusinessProductType
  action       BusinessProductAction
  performedBy  String                  // userId del SuperAdmin o 'system-migration'
  reason       String?                 // motivo opcional ingresado por el SuperAdmin
  metadata     Json?                   // detalle extra (ej. qué bloqueó la desactivación, o los valores de plan al momento de activar)
  createdAt    DateTime                @default(now())

  @@index([businessId, productType])
  @@map("business_product_audit_logs")
}

model MembershipPaymentProduct {
  id                            String                      @id @default(uuid())
  membershipPaymentId           String
  membershipPayment             Membership                  @relation(fields: [membershipPaymentId], references: [id], onDelete: Cascade)
  businessProductSubscriptionId String
  businessProductSubscription   BusinessProductSubscription @relation(fields: [businessProductSubscriptionId], references: [id], onDelete: Cascade)
  amountAttributed              Decimal?                    @db.Decimal(10, 2)
  createdAt                     DateTime                    @default(now())

  @@unique([membershipPaymentId, businessProductSubscriptionId])
  @@index([membershipPaymentId])
  @@index([businessProductSubscriptionId])
  @@map("membership_payment_products")
}

model PosTerminal {
  id                     String    @id @default(uuid())
  businessId             String
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deviceIdentifier       String    @db.VarChar(100)
  name                   String    @db.VarChar(100)
  isActive               Boolean   @default(true)
  hasPendingOfflineSales Boolean   @default(false)
  pendingSalesCount      Int       @default(0)
  lastSeenAt             DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sales                  Sale[]

  @@unique([businessId, deviceIdentifier])
  @@map("pos_terminals")
}

model InventoryDiscrepancy {
  id             String    @id @default(uuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId         String
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  expectedStock  Decimal   @db.Decimal(12, 3)
  resultingStock Decimal   @db.Decimal(12, 3)
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([businessId, resolved])
  @@map("pos_inventory_discrepancies")
}

model PasswordChangeLog {
  id              String   @id @default(uuid())
  targetUserId    String
  changedByUserId String
  changedAt       DateTime @default(now())

  targetUser    User @relation("PasswordChangesReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  changedByUser User @relation("PasswordChangesGiven", fields: [changedByUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@index([changedByUserId])
  @@map("password_change_logs")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Service {
  id                 String                 @id @default(cuid())
  businessId         String
  business           Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String                 @db.VarChar(100)
  description        String?                @db.VarChar(500)
  durationMinutes    Int
  price              Float
  active             Boolean                @default(true)
  hasCustomSchedule  Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  specialists        ServiceSpecialist[]
  appointments       Appointment[]
  schedules          AvailabilitySchedule[]

  @@index([businessId, active])
  @@map("services")
}

model ServiceSpecialist {
  id           String     @id @default(cuid())
  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  commissionPercent Float?
  createdAt    DateTime   @default(now())

  @@unique([serviceId, specialistId])
  @@index([serviceId])
  @@index([specialistId])
  @@map("service_specialists")
}

model AvailabilitySchedule {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  dayOfWeek   Int             // 0=Domingo, 1=Lunes, ..., 6=Sábado
  startTime   String          @db.VarChar(10) // "09:00"
  endTime     String          @db.VarChar(10) // "18:00"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([businessId, serviceId, dayOfWeek])
  @@map("availability_schedules")
}

model BusinessBookingSettings {
  id                    String   @id @default(uuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  minCancellationHours  Int      @default(2)
  trackNoShows          Boolean  @default(false)
  autoBlockAfterNoShows Boolean  @default(false)
  noShowThreshold       Int      @default(3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("business_booking_settings")
}

model Appointment {
  id                 String            @id @default(uuid())
  businessId         String
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId          String?
  service            Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  specialistId       String?
  specialist         Specialist?       @relation(fields: [specialistId], references: [id], onDelete: SetNull)
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName       String            @default("") @db.VarChar(100)
  customerPhone      String?           @db.VarChar(30)
  scheduledAt        DateTime
  durationMinutes    Int
  capacity           Int               @default(1)
  status             AppointmentStatus @default(PENDING)
  price              Float
  customerEmail      String?           @db.VarChar(255)
  manageToken        String            @unique @db.VarChar(100)
  rescheduleCount    Int               @default(0)
  cancellationReason String?           @db.VarChar(500)
  confirmedAt        DateTime?
  confirmationEmailSentAt DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  saleId             String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  items              AppointmentServiceItem[]

  @@index([businessId, status, scheduledAt])
  @@index([manageToken])
  @@index([specialistId])
  @@map("appointments")
}

model AppointmentServiceItem {
  id              String      @id @default(cuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId       String
  serviceName     String      // snapshot, mismo criterio que 75a/78a
  price           Float       // snapshot del Service.price al momento de reservar
  durationMinutes Int         // snapshot del Service.durationMinutes
  orderIndex      Int         @default(0)

  @@index([appointmentId])
  @@map("appointment_service_items")
}

model AppointmentHold {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceIds    String[]
  specialistId  String
  startAt       DateTime
  endAt         DateTime
  holderToken   String   // token random generado al crear el hold, para validar que solo el dueño lo libere/confirme
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([businessId, specialistId, startAt])
  @@index([expiresAt])
  @@map("appointment_holds")
}

model Profession {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String       @db.VarChar(60)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  specialists Specialist[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("professions")
}

model Specialist {
  id                 String              @id @default(cuid())
  businessId         String
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String              @db.VarChar(150)
  specialty          String?             @db.VarChar(150)
  professionId       String?
  profession         Profession?         @relation(fields: [professionId], references: [id], onDelete: SetNull)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  serviceSpecialists ServiceSpecialist[]
  appointments       Appointment[]

  @@index([businessId])
  @@index([professionId])
  @@map("specialists")
}

// ==========================================
// MÓDULO 103a: Industrias y Campos Dinámicos
// ==========================================

model Industry {
  id            String                  @id @default(uuid())
  code          String                  @unique @db.VarChar(50)
  name          String                  @db.VarChar(100)
  posVertical   PosVertical             @default(RETAIL)
  usesVariants  Boolean                 @default(false)
  tracksBatches Boolean                 @default(false)
  isActive      Boolean                 @default(true)
  order         Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  fieldTemplates IndustryFieldTemplate[]
  businesses     Business[]

  @@map("industries")
}

model IndustryFieldTemplate {
  id          String               @id @default(uuid())
  industryId  String
  industry    Industry             @relation(fields: [industryId], references: [id], onDelete: Cascade)
  key         String               @db.VarChar(50)
  label       String               @db.VarChar(100)
  dataType    ProductFieldDataType
  required    Boolean              @default(false)
  options     Json?
  order       Int                  @default(0)
  searchable  Boolean              @default(false)
  showInPos   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([industryId, key])
  @@map("industry_field_templates")
}

model ProductFieldDefinition {
  id          String               @id @default(uuid())
  businessId  String
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key         String               @db.VarChar(50)
  label       String               @db.VarChar(100)
  dataType    ProductFieldDataType
  required    Boolean              @default(false)
  options     Json?
  order       Int                  @default(0)
  searchable  Boolean              @default(false)
  showInPos   Boolean              @default(false)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([businessId, key])
  @@index([businessId, isActive])
  @@map("product_field_definitions")
}

model PlatformSetting {
  key             String   @id @db.VarChar(100)
  value           String   @db.Text
  description     String?  @db.VarChar(255)
  updatedByUserId String?  @db.VarChar(100)
  updatedAt       DateTime @default(now()) @updatedAt

  @@map("platform_settings")
}
