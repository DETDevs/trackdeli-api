generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ENCARGADO
  REPARTIDOR
  SUPERADMIN
}

enum OrderStatus {
  PENDIENTE
  OFERTADO
  COTIZANDO
  ACEPTADO
  EN_CAMINO_AL_NEGOCIO
  EN_EL_NEGOCIO
  EN_CAMINO
  CERCA_DEL_DESTINO
  VERIFICANDO_ENTREGA
  ENTREGADO
  CANCELADO
  INCIDENCIA
  CERRADO
}

enum BusinessType {
  NEGOCIO
  EMPRESA_RIDERS
}

enum DispatchStatus {
  SENT
  ACCEPTED
  REJECTED
  TIMEOUT
}

enum CommissionStatus {
  PENDING
  INCLUDED
  PAID
}

enum StatementStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum QuoteStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum DeliveryPaymentStatus {
  PAGADO
  CONTRA_ENTREGA
  GRATIS
}

enum OrderPhotoType {
  ARMADO
  ENTREGA
}

enum VehicleType {
  MOTO
  BICICLETA
  CARRO
  A_PIE
}

enum PricingModel {
  FREE
  FIXED
  PER_KM
  RIDER_QUOTE
}

enum PaymentMethod {
  TRANSFERENCIA
  EFECTIVO
  PAYPAL
  BINANCE
  OTRO
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

// ─── POS ENUMS ───

enum PosPaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CREDITO
  MIXTO
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CashStatus {
  OPEN
  CLOSED
}

enum MovementType {
  ENTRADA
  SALIDA
}

enum StockMovementType {
  COMPRA
  VENTA
  AJUSTE
  DEVOLUCION
  PERDIDA
  TRASLADO
}

model Business {
  id                     String       @id @default(uuid())
  name                   String       @db.VarChar(100)
  type                   String?      @db.VarChar(50)
  logoUrl                String?      @db.VarChar(500)
  defaultGeofenceRadiusM Int          @default(100)
  latitude               Float?
  longitude              Float?
  isActive               Boolean      @default(true)

  // Tipo de negocio y comisiones
  businessType            BusinessType  @default(NEGOCIO)
  commissionRate          Float         @default(0.15) // 15% default
  altCommissionRate       Float         @default(0.12) // 12% para >40km
  altCommissionDistanceKm Float         @default(40)   // umbral en km
  dispatchTimeoutMin      Int           @default(3)    // minutos antes de pasar al siguiente

  // Módulos activos
  hasTrackDeli           Boolean      @default(true)
  hasPOS                 Boolean      @default(false)

  // Modelo de precios (TrackDeli)
  pricingModel           PricingModel @default(FIXED)
  baseRate               Float        @default(0)
  ratePerKm              Float        @default(0)
  freeZoneKm             Float        @default(0)
  minRate                Float        @default(0)
  maxRate                Float        @default(0)
  pricingZones           Json?

  // Contacto del negocio
  whatsappNumber         String?      @db.VarChar(20)
  whatsappDisplay        String?      @db.VarChar(30)

  // Configuración del POS
  taxRate                Float        @default(0)
  currency               String       @default("NIO") @db.VarChar(10)
  invoicePrefix          String       @default("FAC") @db.VarChar(10)
  invoiceCounter         Int          @default(1)
  posAddress             String?      @db.VarChar(300)
  posPhone               String?      @db.VarChar(30)
  posFooter              String?      @db.VarChar(200)

  createdAt              DateTime     @default(now())

  // TrackDeli relations
  users       User[]
  orders      Order[]
  memberships Membership[]
  clients     BusinessClient[]
  commissions OrderCommission[]
  statements  MonthlyStatement[]

  // POS relations
  categories      Category[]
  suppliers       Supplier[]
  products        Product[]
  sales           Sale[]
  cashRegisters   CashRegister[]
  cashMovements   CashMovement[]

  @@map("businesses")
}

model BusinessClient {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String   @db.VarChar(150)
  phone      String?  @db.VarChar(30)
  address    String?  @db.VarChar(300)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  orders     Order[]

  @@map("business_clients")
}

model Membership {
  id              String           @id @default(uuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id])

  // Período de vigencia
  startDate       DateTime
  endDate         DateTime

  // Pago
  amount          Float
  currency        String           @default("USD")
  paymentMethod   PaymentMethod    @default(TRANSFERENCIA)
  paymentProofUrl String?          @db.VarChar(500)
  paidAt          DateTime?
  notes           String?

  status          MembershipStatus @default(ACTIVE)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String

  @@map("memberships")
}

model User {
  id           String   @id @default(uuid())
  businessId   String?
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  phone        String?  @db.VarChar(20)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(REPARTIDOR)
  isActive     Boolean  @default(true)
  
  vehicleType      VehicleType?
  vehiclePlate     String?
  vehicleColor     String?
  vehiclePhotoUrl  String?
  profilePhotoUrl  String?
  
  currentLatitude  Float?
  currentLongitude Float?
  lastLocationAt   DateTime?
  isAvailable      Boolean  @default(true)
  
  createdAt    DateTime @default(now())

  // TrackDeli relations
  business              Business?          @relation(fields: [businessId], references: [id])
  createdOrders         Order[]            @relation("OrderCreatedBy")
  deliveredOrders       Order[]            @relation("OrderDeliveredBy")
  locationSnapshots     LocationSnapshot[]
  notifications         Notification[]
  deviceTokens          DeviceToken[]
  quotes                OrderQuote[]       @relation("RiderQuotes")
  sentMessages          OrderMessage[]     @relation("SentMessages")
  dispatches            OrderDispatch[]    @relation("RiderDispatches")

  // POS relations
  sales          Sale[]          @relation("CashierSales")
  cashRegisters  CashRegister[]  @relation("CashierRegisters")
  cashMovements  CashMovement[]  @relation("UserMovements")
  stockMovements StockMovement[] @relation("UserStockMovements")

  @@map("users")
}

model Order {
  id                    String                @id @default(uuid())
  businessId            String
  createdBy             String
  deliveryUserId        String?
  status                OrderStatus           @default(PENDIENTE)

  customerName          String                @db.VarChar(100)
  customerPhone         String                @db.VarChar(20)

  originBusinessName     String?               @db.VarChar(150)
  originBusinessClientId String?
  originBusinessClient   BusinessClient?       @relation(fields: [originBusinessClientId], references: [id])

  destinationAddress    String?               @db.VarChar(300)
  destinationLat        Decimal?              @db.Decimal(10, 7)
  destinationLng        Decimal?              @db.Decimal(10, 7)
  geofenceRadiusM       Int                   @default(100)

  description           String?

  deliveryPaymentStatus DeliveryPaymentStatus @default(GRATIS)
  deliveryFee           Decimal               @default(0) @db.Decimal(10, 2)
  distanceKm            Float                 @default(0)
  priceNegotiated       Boolean               @default(false)

  deliveryConfirmationUrl String?             @db.VarChar(500)
  signatureUrl            String?             @db.VarChar(500)

  takenAt               DateTime?
  arrivedAtBusinessAt   DateTime?
  pickedUpAt            DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime              @default(now())

  business              Business              @relation(fields: [businessId], references: [id])
  creator               User                  @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  deliveryUser          User?                 @relation("OrderDeliveredBy", fields: [deliveryUserId], references: [id])
  photos                OrderPhoto[]
  trackingSession       TrackingSession?
  locationSnapshots     LocationSnapshot[]
  rating                Rating?
  notifications         Notification[]
  quotes                OrderQuote[]
  messages              OrderMessage[]
  dispatches            OrderDispatch[]
  commission            OrderCommission?

  @@map("orders")
}

model OrderDispatch {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id])
  riderId     String
  rider       User           @relation("RiderDispatches", fields: [riderId], references: [id])
  attempt     Int            // intento #1, #2, #3...
  status      DispatchStatus @default(SENT)
  sentAt      DateTime       @default(now())
  respondedAt DateTime?
  timeoutAt   DateTime       // cuando expira si no responde

  @@index([orderId, attempt])
  @@map("order_dispatches")
}

model OrderCommission {
  id               String            @id @default(uuid())
  orderId          String            @unique
  order            Order             @relation(fields: [orderId], references: [id])
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id])
  deliveryFee      Float             // monto del envío cobrado al cliente
  distanceKm       Float             // distancia recorrida
  commissionRate   Float             // 0.15 o 0.12
  commissionAmount Float             // monto de comisión = deliveryFee * commissionRate
  status           CommissionStatus  @default(PENDING)
  statementId      String?           // a qué estado de cuenta pertenece
  statement        MonthlyStatement? @relation(fields: [statementId], references: [id])
  createdAt        DateTime          @default(now())

  @@map("order_commissions")
}

model MonthlyStatement {
  id               String            @id @default(uuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id])
  month            Int               // 1-12
  year             Int
  totalDeliveries  Int               // cantidad de pedidos entregados
  totalDeliveryFee Float             // suma de todos los montos de envío
  totalCommission  Float             // suma de todas las comisiones = lo que debe pagar
  status           StatementStatus   @default(PENDING)
  dueDate          DateTime          // fecha límite de pago (ej: 5 del mes siguiente)
  paidAt           DateTime?
  paidAmount       Float?            // puede ser pago parcial
  notes            String?
  commissions      OrderCommission[]
  createdAt        DateTime          @default(now())

  @@unique([businessId, month, year])
  @@map("monthly_statements")
}

model OrderQuote {
  id                   String       @id @default(uuid())
  orderId              String
  order                Order        @relation(fields: [orderId], references: [id])
  riderId              String
  rider                User         @relation("RiderQuotes", fields: [riderId], references: [id])

  proposedFee          Float
  counterFee           Float?
  finalFee             Float?

  distanceToBusinessKm Float?
  etaToBusinessMin     Int?

  status               QuoteStatus  @default(PENDING)

  messages             OrderMessage[]

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([orderId, riderId])
  @@map("order_quotes")
}

model OrderMessage {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  quoteId     String?
  quote       OrderQuote? @relation(fields: [quoteId], references: [id])
  senderId    String
  sender      User        @relation("SentMessages", fields: [senderId], references: [id])
  senderRole  UserRole
  message     String      @db.VarChar(500)
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@map("order_messages")
}

model OrderPhoto {
  id        String         @id @default(uuid())
  orderId   String
  photoUrl  String         @db.VarChar(500)
  type      OrderPhotoType
  createdAt DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_photos")
}

model TrackingSession {
  id        String   @id @default(uuid())
  orderId   String   @unique
  token     String   @unique @db.VarChar(64)
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("tracking_sessions")
}

model LocationSnapshot {
  id         String   @id @default(uuid())
  orderId    String
  userId     String
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  speed      Decimal? @db.Decimal(5, 2)
  isMock     Boolean  @default(false)
  recordedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("location_snapshots")
}

model Rating {
  id        String   @id @default(uuid())
  orderId   String   @unique
  stars     Int      @db.SmallInt
  comment   String?
  tipAmount Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("ratings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  orderId   String?
  type      String   @db.VarChar(50)
  title     String?  @db.VarChar(200)
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("device_tokens")
}

// ═══════════════════════════════════════════════
// POS MODELS
// ═══════════════════════════════════════════════

model Category {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  name       String    @db.VarChar(100)
  color      String?   @db.VarChar(10)
  icon       String?   @db.VarChar(50)
  isActive   Boolean   @default(true)
  products   Product[]
  createdAt  DateTime  @default(now())

  @@unique([businessId, name])
  @@map("pos_categories")
}

model Supplier {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  name       String    @db.VarChar(100)
  phone      String?   @db.VarChar(30)
  email      String?   @db.VarChar(150)
  address    String?   @db.VarChar(300)
  notes      String?
  isActive   Boolean   @default(true)
  products   Product[]
  createdAt  DateTime  @default(now())

  @@map("pos_suppliers")
}

model Product {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])

  name        String    @db.VarChar(200)
  description String?
  barcode     String?   @db.VarChar(50)
  sku         String?   @db.VarChar(50)
  imageUrl    String?   @db.VarChar(500)

  price       Float
  cost        Float?
  taxIncluded Boolean   @default(true)

  trackStock  Boolean   @default(true)
  stock       Int       @default(0)
  minStock    Int       @default(5)
  maxStock    Int?

  isActive    Boolean   @default(true)

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, barcode])
  @@unique([businessId, sku])
  @@map("pos_products")
}

model Sale {
  id             String           @id @default(uuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id])
  cashRegisterId String?
  cashRegister   CashRegister?    @relation(fields: [cashRegisterId], references: [id])
  cashierId      String
  cashier        User             @relation("CashierSales", fields: [cashierId], references: [id])

  invoiceNumber  String           @db.VarChar(30)
  invoiceDate    DateTime         @default(now())

  customerName   String?          @db.VarChar(100)
  customerPhone  String?          @db.VarChar(30)
  customerRuc    String?          @db.VarChar(30)

  items          SaleItem[]

  subtotal       Float
  discountAmount Float            @default(0)
  taxAmount      Float            @default(0)
  total          Float

  paymentMethod  PosPaymentMethod @default(EFECTIVO)
  amountPaid     Float
  change         Float            @default(0)
  reference      String?          @db.VarChar(100)

  status         SaleStatus       @default(COMPLETED)
  notes          String?
  printCount     Int              @default(0)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("pos_sales")
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])

  productName String   @db.VarChar(200)
  barcode     String?  @db.VarChar(50)
  unitPrice   Float
  quantity    Float
  discount    Float    @default(0)
  subtotal    Float

  @@map("pos_sale_items")
}

model CashRegister {
  id            String     @id @default(uuid())
  businessId    String
  business      Business   @relation(fields: [businessId], references: [id])
  cashierId     String
  cashier       User       @relation("CashierRegisters", fields: [cashierId], references: [id])

  openedAt      DateTime   @default(now())
  closedAt      DateTime?

  openingCash   Float
  closingCash   Float?
  expectedCash  Float?
  difference    Float?

  totalSales    Float?
  totalCash     Float?
  totalCard     Float?
  totalTransfer Float?

  notes         String?
  status        CashStatus @default(OPEN)

  sales         Sale[]
  movements     CashMovement[]

  createdAt     DateTime   @default(now())

  @@map("pos_cash_registers")
}

model CashMovement {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  userId         String
  user           User         @relation("UserMovements", fields: [userId], references: [id])

  type           MovementType
  amount         Float
  concept        String       @db.VarChar(300)

  createdAt      DateTime     @default(now())

  @@map("pos_cash_movements")
}

model StockMovement {
  id          String            @id @default(uuid())
  businessId  String
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  userId      String
  user        User              @relation("UserStockMovements", fields: [userId], references: [id])

  type        StockMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  cost        Float?
  concept     String            @db.VarChar(300)
  reference   String?           @db.VarChar(100)

  createdAt   DateTime          @default(now())

  @@map("pos_stock_movements")
}
